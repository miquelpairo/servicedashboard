// Helper para resize de gráficos Plotly
function resizeVisibleCharts(selector) {
  const charts = document.querySelectorAll(selector + ' .js-plotly-plot');
  charts.forEach(gd => {
    try {
      Plotly.Plots.resize(gd);
      Plotly.relayout(gd, { autosize: true });
    } catch (err) {}
  });
}

function forceResizeByIds(ids) {
  ids.forEach(id => {
    const gd = document.getElementById(id);
    if (!gd) return;
    try {
      Plotly.Plots.resize(gd);
      Plotly.relayout(gd, { autosize: true });
    } catch (err) {}
  });
}

// Manejo de tabs con vanilla JS
const trendsTabs = document.querySelectorAll('#trendsTab a[data-toggle="tab"]');

trendsTabs.forEach(tab => {
  tab.addEventListener('click', function(e) {
    e.preventDefault();
    
    // Remover active de todos
    document.querySelectorAll('#trendsTab .nav-link').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('#trendsTabContent .tab-pane').forEach(p => {
      p.classList.remove('show', 'active');
    });
    
    // Activar clickeado
    this.classList.add('active');
    
    const targetId = this.getAttribute('href');
    const targetPane = document.querySelector(targetId);
    
    if (targetPane) {
      targetPane.classList.add('show', 'active');
      
      // Map de tabs a chart IDs
      const chartMap = {
        '#reps-trend': ['chartRepsTrend'],
        '#types-trend': ['chartTypesTrend'],
        '#sets-trend': ['chartSetsTrend'],
        '#month-trend': ['chartMonthTrend']
      };
      
      const chartIds = chartMap[targetId] || [];
      
      // Función de resize con múltiples intentos (como en Sales Comparison)
      function fix() {
        resizeVisibleCharts(targetId);
        forceResizeByIds(chartIds);
      }
      
      // Múltiples llamadas para asegurar resize correcto
      requestAnimationFrame(fix);
      setTimeout(fix, 50);
      setTimeout(fix, 180);
      setTimeout(fix, 450);
    }
  });
});

