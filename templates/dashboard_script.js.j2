/// ============================================
// EMBEDDED DATA
// ============================================
const fullData = {{ full_data_json | safe }};
const mapData = {{ map_data_json | safe }};
const coordsCache = {{ coords_cache_json | safe }};

const productTypes = {{ product_types_list | tojson }};
const availableYears = {{ available_years | tojson }};
const availableMonths = {{ available_months | tojson }};
const availableReps = {{ available_reps | tojson }};
const availableTypes = {{ available_types | tojson }};
const availableSets = {{ available_sets | tojson }};
const availableCountries = {{ available_countries | tojson }};

{% if has_segment %}
const availableSegments = {{ available_segments | tojson }};
{% endif %}
{% if has_market_org %}
const availableMarketOrgs = {{ available_market_orgs | tojson }};
{% endif %}

const monthNames = ['January','February','March','April','May','June',
                    'July','August','September','October','November','December'];

// FEATURE FLAGS (desde Python)
const HAS_CITY = {{ 'true' if has_city else 'false' }};
const HAS_SEGMENT = {{ 'true' if has_segment else 'false' }};
const HAS_MARKET_ORG = {{ 'true' if has_market_org else 'false' }};

// Detectar si hay datos reales de City (no solo columna)
const HAS_CITY_DATA = Array.isArray(fullData) && fullData.some(row => {
  const city = String(row.City || '').trim();
  return city.length > 0;
});

// ============================================
// STATE
// ============================================
let filteredData = Array.isArray(fullData) ? [...fullData] : [];
let filteredMapData = [];
let activeQuickFilters = [];
let quickMode = 'AND';
let sortState = { column: 0, ascending: false };
const STORAGE_KEY = 'service_dashboard_filters_v1';

// ============================================
// HELPERS
// ============================================
function $(id) { return document.getElementById(id); }

function safeLower(v) {
  return String(v ?? '').toLowerCase();
}

function escapeHtml(str) {
  return String(str ?? '')
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');
}

function normCountry(v) {
  // clave estable para comparar: nombre en minúsculas sin espacios extra
  return String(v ?? '').trim().toLowerCase();
}

function countryToISO2(v) {
  // solo para mostrar banderitas (no afecta al filtro)
  const s = normCountry(v);
  const map = {
    'spain': 'es',
    'portugal': 'pt',
    'united kingdom': 'gb',
    'latvia': 'lv',
    'lithuania': 'lt',
    'estonia': 'ee',
    'iceland': 'is',
    'norway': 'no',
    'finland': 'fi',
    // añade aquí si quieres más
  };
  return map[s] || s; // si no está, devuelve el nombre
}

function formatCountryName(v) {
  const iso = countryToISO2(v);
  const flags = {
    es: '🇪🇸 Spain',
    pt: '🇵🇹 Portugal',
    gb: '🇬🇧 United Kingdom',
    lv: '🇱🇻 Latvia',
    lt: '🇱🇹 Lithuania',
    ee: '🇪🇪 Estonia',
    is: '🇮🇸 Iceland',
    no: '🇳🇴 Norway',
    fi: '🇫🇮 Finland'
  };
  return flags[iso] || String(v); // fallback: texto tal cual
}

function normPostal(v) {
  // Normaliza postal para key: trim + upper
  // (no forzamos regex, porque fuera ES/PT hay formatos distintos)
  return String(v ?? '').trim().toUpperCase();
}

function makeLocationKey(postal, country) {
  return `${normPostal(postal)}__${normCountry(country)}`;
}

function getCheckedValues(selector, mapFn) {
  return Array.from(document.querySelectorAll(selector + ':checked'))
    .map(cb => mapFn ? mapFn(cb) : cb.value);
}

function setAll(selector, checked) {
  document.querySelectorAll(selector).forEach(cb => cb.checked = checked);
}

function debounce(fn, ms) {
  let t = null;
  return function() {
    clearTimeout(t);
    t = setTimeout(() => fn(), ms);
  };
}

function getAccountLinkFromRow(row) {
  const name = String(row['Business Partner Name'] ?? '').trim();

  // Prioridad: AccountURL (si lo generas en Python) -> SFDC Link (si viene en DF)
  const url = (row?.AccountURL && String(row.AccountURL).trim())
    ? String(row.AccountURL).trim()
    : (row?.['SFDC Link'] && String(row['SFDC Link']).trim())
      ? String(row['SFDC Link']).trim()
      : null;

  if (url) {
    return `<a href="${url}" target="_blank" style="color:#2E86C1; text-decoration:none;">${escapeHtml(name)}</a>`;
  }
  return escapeHtml(name);
}

// ============================================
// ALL/NONE GROUP BUTTONS
// ============================================
function setGroupChecked(group, checked) {
  const map = {
    country: '.country-filter',
    year: '.year-filter',
    month: '.month-filter',
    rep: '.rep-filter',
    type: '.type-filter',
    set: '.set-filter'
    {% if has_segment %}, segment: '.segment-filter'{% endif %}
    {% if has_market_org %}, marketOrg: '.marketorg-filter'{% endif %}
  };

  const selector = map[group];
  if (!selector) return;

  setAll(selector, checked);
  saveFilterState();
  applyFilters();
}

// ============================================
// QUICK FILTERS
// ============================================
function toggleQuickFilter(el) {
  const key = el.getAttribute('data-keyword');
  el.classList.toggle('active');

  if (el.classList.contains('active')) {
    if (!activeQuickFilters.includes(key)) activeQuickFilters.push(key);
  } else {
    activeQuickFilters = activeQuickFilters.filter(k => k !== key);
  }

  saveFilterState();
}

function setQuickMode(mode) {
  quickMode = mode;
  saveFilterState();
  applyFilters();
}

// ============================================
// INITIALIZE FILTER UI
// ============================================
