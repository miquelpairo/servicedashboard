// ============================================
// MULTI-YEAR TRENDS - DATA AGGREGATION
// ============================================

/**
 * Agrupa datos por año y categoría, retorna top N por último año
 * @param {Array} data - Dataset filtrado
 * @param {string} categoryField - Campo a agrupar ('SalesRepresentative', 'ProductType', 'Set')
 * @param {number} topN - Número de elementos a retornar
 * @returns {Object} { categories: [...], years: [...], matrix: {...} }
 */
function aggregateByYearAndCategory(data, categoryField, topN = TOP_N_TRENDS) {
  if (!data || !data.length) return { categories: [], years: [], matrix: {} };

  const yearSet = new Set();
  const categoryTotals = {}; // { category: { year: eur } }

  // 1. Agrupar por categoría y año
  data.forEach(row => {
    const year = row.__year;
    const category = String(row[categoryField] || '(Unknown)').trim();
    
    if (year === null) return;
    
    yearSet.add(year);
    
    if (!categoryTotals[category]) categoryTotals[category] = {};
    categoryTotals[category][year] = (categoryTotals[category][year] || 0) + (row.EUR || 0);
  });

  const years = Array.from(yearSet).sort((a, b) => a - b);
  if (!years.length) return { categories: [], years: [], matrix: {} };

  const lastYear = years[years.length - 1];

  // 2. Ordenar categorías por total del último año
  const categoriesWithTotal = Object.entries(categoryTotals).map(([cat, yearData]) => ({
    category: cat,
    lastYearTotal: yearData[lastYear] || 0
  }));

  categoriesWithTotal.sort((a, b) => b.lastYearTotal - a.lastYearTotal);

  // 3. Tomar top N
  const topCategories = categoriesWithTotal.slice(0, topN).map(c => c.category);

  // 4. Construir matriz de datos
  const matrix = {};
  topCategories.forEach(cat => {
    matrix[cat] = {};
    years.forEach(y => {
      matrix[cat][y] = categoryTotals[cat][y] || 0;
    });
  });

  return { categories: topCategories, years, matrix };
}

/**
 * Agrupa datos por año y mes
 * @param {Array} data - Dataset filtrado
 * @returns {Object} { years: [...], monthlyData: { year: { month: eur } } }
 */
function aggregateByYearAndMonth(data) {
  if (!data || !data.length) return { years: [], monthlyData: {} };

  const yearSet = new Set();
  const monthlyData = {}; // { year: { month: eur } }

  data.forEach(row => {
    const year = row.__year;
    const month = row.__month;
    
    if (year === null || month === null) return;
    
    yearSet.add(year);
    
    if (!monthlyData[year]) monthlyData[year] = {};
    monthlyData[year][month] = (monthlyData[year][month] || 0) + (row.EUR || 0);
  });

  const years = Array.from(yearSet).sort((a, b) => a - b);

  return { years, monthlyData };
}

