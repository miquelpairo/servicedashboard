// ============================================
// GZIP + BASE64 DECODER
// ============================================
function decodeBase64ToUint8Array(b64) {
  const binary = atob(b64);
  const bytes = new Uint8Array(binary.length);
  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
  return bytes;
}

function loadJsonFromGzipBase64(b64gz) {
  if (!b64gz || b64gz === "undefined") return null;
  const bytes = decodeBase64ToUint8Array(b64gz);
  const jsonStr = pako.ungzip(bytes, { to: "string" });
  if (!jsonStr || jsonStr === "undefined") return null;
  return JSON.parse(jsonStr);
}

