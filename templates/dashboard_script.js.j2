function normPostal(v) {
  return String(v ?? '').trim().toUpperCase();
}

function makeLocationKey(postal, country) {
  // Usa la versión KEY-safe del country (ISO2)
  return `${normPostal(postal)}__${normCountryForKey(country)}`;
}

// ============================================
// COLUMNAR HELPERS (multi-alias support)
// ============================================

// Busca la primera columna que existe entre aliases
function pickCol(cols, ...aliases) {
  if (!cols) return null;
  for (const alias of aliases) {
    if (cols[alias] !== undefined) return cols[alias];
  }
  return null;
}

// dict lookup seguro
function dictGet(dictArr, id) {
  if (id === null || id === undefined) return "";
  const n = dictArr?.length ?? 0;
  if (id < 0 || id >= n) return "";
  return dictArr[id] ?? "";
}

// Parse fecha robusto (soporta múltiples formatos)
function parseDate(v) {
  if (!v) return null;
  
  // Si ya es Date
  if (v instanceof Date) return isNaN(v) ? null : v;
  
  const s = String(v).trim();
  if (!s) return null;
  
  // Timestamp numérico
  if (/^\d+$/.test(s)) {
    const ts = parseInt(s, 10);
    const d = new Date(ts);
    return isNaN(d) ? null : d;
  }
  
  // ISO / YYYY-MM-DD / YYYY/MM/DD
  if (/^\d{4}[-/]\d{1,2}[-/]\d{1,2}/.test(s)) {
    const d = new Date(s);
    return isNaN(d) ? null : d;
  }
  
  // DD/MM/YYYY o DD-MM-YYYY
  const dmy = s.match(/^(\d{1,2})[-/](\d{1,2})[-/](\d{4})/);
  if (dmy) {
    const d = new Date(`${dmy[3]}-${dmy[2]}-${dmy[1]}`);
    return isNaN(d) ? null : d;
  }
  
  // Fallback: new Date()
  const d = new Date(s);
  return isNaN(d) ? null : d;
}

// ============================================
// COLUMNAR -> LEGACY (inflate)
// ============================================

function inflateColumnarDataset(ds) {
  // Si ya es legacy (array de rows), devuelve tal cual
  if (Array.isArray(ds)) return ds;

  // Si no tiene estructura columnar, devuelve []
  if (!ds || !ds.dict || !ds.cols || !ds.meta) return [];

  const n = Number(ds.meta.n || 0);
  const dicts = ds.dict;
  const cols = ds.cols;

  // Detectar columnas disponibles (alias-aware)
  const colDate = pickCol(cols, 'date', 'Date', 'invoiceDate', 'invoice_date');
  const colCountry = pickCol(cols, 'country', 'countryId', 'country_id', 'ctry', 'ctryId');
  const colRep = pickCol(cols, 'rep', 'repId', 'rep_id', 'salesRep');
  const colType = pickCol(cols, 'type', 'typeId', 'type_id', 'productType');
  const colSet = pickCol(cols, 'set', 'setId', 'set_id');
  const colClient = pickCol(cols, 'client', 'clientId', 'client_id', 'customer', 'customerId');
  const colService = pickCol(cols, 'service', 'serviceId', 'service_id', 'item', 'itemId');
  const colAccountUrl = pickCol(cols, 'accountUrl', 'accountUrlId', 'account_url', 'sfdc_link');
  const colCity = pickCol(cols, 'city', 'cityId', 'city_id');
  const colPostal = pickCol(cols, 'postal', 'postalId', 'postal_id', 'postalCode', 'postal_code', 'zip');
  const colSegment = pickCol(cols, 'segment', 'segmentId', 'segment_id', 'endUserSegment');
  const colMarketOrg = pickCol(cols, 'marketOrg', 'marketOrgId', 'market_org', 'marketOrgName');
  const colEur = pickCol(cols, 'eur', 'EUR', 'euro', 'amount', 'value');

  const rows = new Array(n);
  let validDates = 0;

  for (let i = 0; i < n; i++) {
    // Parse fecha UNA VEZ y cachear año/mes
    const dateStr = colDate?.[i] ?? "";
    const dateObj = parseDate(dateStr);
    const year = dateObj ? dateObj.getFullYear() : null;
    const month = dateObj ? (dateObj.getMonth() + 1) : null;
    
    if (dateObj) validDates++;

    // Country: nombre original para display
    const countryName = dictGet(dicts.country, colCountry?.[i]);
    
    // 🔥 FIX #3: Pre-cache strings lowercase para búsquedas
    const service = dictGet(dicts.service, colService?.[i]);
    const client = dictGet(dicts.client, colClient?.[i]);

    rows[i] = {
      Date: dateStr,
      __dateObj: dateObj,  // cache para sorts
      __year: year,        // cache para filtros (evita new Date en loop)
      __month: month,

      // Display values (nombres originales)
      Country: countryName,
      CountryKey: normCountryForKey(countryName), // Para makeLocationKey
      
      SalesRepresentative: dictGet(dicts.rep, colRep?.[i]),
      ProductType: dictGet(dicts.type, colType?.[i]),
      Set: dictGet(dicts.set, colSet?.[i]),
      "Business Partner Name": client,
      ItemIdAndName: service,
      AccountURL: dictGet(dicts.accountUrl, colAccountUrl?.[i]),
      City: dictGet(dicts.city, colCity?.[i]),
      PostalCode: normPostal(dictGet(dicts.postal, colPostal?.[i])),
      "End User Segment": dictGet(dicts.segment, colSegment?.[i]),
      "Market Organization Name": dictGet(dicts.marketOrg, colMarketOrg?.[i]),

      // 🔥 FIX #3: Cache lowercase para búsquedas (evita toLowerCase en cada filtro)
      __serviceLower: String(service || '').toLowerCase(),
      __clientLower: String(client || '').toLowerCase(),

      // num
      EUR: Number(colEur?.[i] ?? 0)
    };
  }

  if (DEBUG) {
    console.log('🔍 inflateColumnarDataset:');
    console.log(`  - Total rows: ${n}`);
    console.log(`  - Valid dates: ${validDates} (${((validDates/n)*100).toFixed(1)}%)`);
    console.log(`  - Sample row:`, rows[0]);
    console.log(`  - Columns detected:`, {
      date: !!colDate,
      country: !!colCountry,
      postal: !!colPostal,
      eur: !!colEur
    });
  }

  return rows;
}

function inflateMapPointsToLegacyMapData(mp) {
  if (!mp || !mp.dict || !mp.cols) return [];

  const n = Number(mp.meta?.n ?? (mp.cols.lat?.length || 0));
  const dictLoc = mp.dict.locKey || [];
  const dictCity = mp.dict.resolvedCity || [];
  const cols = mp.cols;

  const out = [];
  for (let i = 0; i < n; i++) {
    const lat = Number(cols.lat?.[i]);
    const lon = Number(cols.lon?.[i]);
    if (!Number.isFinite(lat) || !Number.isFinite(lon)) continue;

    const locKey = dictGet(dictLoc, cols.locId?.[i]); // "POSTAL__country"
    const parts = String(locKey || "__").split("__");
    const postal = normPostal(parts[0] || "");
    const countryFromKey = parts[1] || "";

    out.push({
      PostalCode: postal,
      Country: countryFromKey, // nombre original del key
      CountryKey: normCountryForKey(countryFromKey), // Para makeLocationKey
      City: "",
      ResolvedCity: dictGet(dictCity, cols.cityId?.[i]),
      Latitude: lat,
      Longitude: lon,
      GeoValidated: (Number(cols.validated?.[i] ?? 1) === 1)
    });
  }

  if (DEBUG) {
    console.log('🔍 inflateMapPointsToLegacyMapData:');
    console.log(`  - Total points: ${out.length}`);
    if (out.length > 0) {
      console.log(`  - Sample point:`, out[0]);
    }
  }

  return out;
}

