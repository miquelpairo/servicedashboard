// ============================================
// 🔥 CASCADING FILTERS (Bidirectional Country ↔ MarketOrg)
// ============================================

/**
 * Filtra fullData EXCLUYENDO el grupo que estamos calculando (leave-one-out).
 * @param {string} excludeGroup - 'country' o 'marketOrg' para excluir de filtrado
 */
function computeCascadeBase(excludeGroup = null) {
  const selectedYears = getCheckedValues('.year-filter', cb => parseInt(cb.value, 10));
  let selectedMonths = getCheckedValues('.month-filter', cb => parseInt(cb.value, 10));
  
  // 🔥 FIX: Leave-one-out - NO filtrar por el grupo que estamos calculando
  const selectedCountries = (excludeGroup === 'country') 
    ? [] 
    : getCheckedValues('.country-filter');
  
  {% if has_market_org %}
  const selectedMarketOrgs = (excludeGroup === 'marketOrg') 
    ? [] 
    : getCheckedValues('.marketorg-filter');
  {% endif %}

  if (selectedMonths.length === 0) selectedMonths = [...availableMonths];

  return fullData.filter(row => {
    // Filtrar por Country solo si NO estamos calculando Country
    if (excludeGroup !== 'country' && selectedCountries.length && !selectedCountries.includes(row.Country)) {
      return false;
    }
    
    const y = row.__year;
    const m = row.__month;
    if (y === null || m === null) return false;
    if (selectedYears.length && !selectedYears.includes(y)) return false;
    if (selectedMonths.length && !selectedMonths.includes(m)) return false;

    {% if has_market_org %}
    // Filtrar por MarketOrg solo si NO estamos calculando MarketOrg
    if (excludeGroup !== 'marketOrg' && selectedMarketOrgs.length && !selectedMarketOrgs.includes(row['Market Organization Name'])) {
      return false;
    }
    {% endif %}

    return true;
  });
}

/**
 * Calcula qué valores están disponibles en baseRows para cada filtro.
 */
function computeAvailableValues(baseRows) {
  const available = {
    countries: new Set(),
    reps: new Set(),
    types: new Set(),
    sets: new Set()
    {% if has_market_org %}, marketOrgs: new Set(){% endif %}
  };

  for (const row of baseRows) {
    if (row.Country) available.countries.add(row.Country);
    if (row.SalesRepresentative) available.reps.add(row.SalesRepresentative);
    if (row.ProductType) available.types.add(row.ProductType);
    if (row.Set) available.sets.add(row.Set);
    {% if has_market_org %}
    if (row['Market Organization Name']) available.marketOrgs.add(row['Market Organization Name']);
    {% endif %}
  }

  return available;
}

/**
 * 🔥 FIX: Aplica disable + hide SELECTIVAMENTE según el grupo.
 * @param {object} available - Sets de valores disponibles
 * @param {string} lastChangedGroup - 'country' | 'marketOrg' | null
 */
function applyAvailability(available, lastChangedGroup = null) {
  // 🔥 Country: disable + hide SOLO si NO fue el último cambiado
  const shouldHideCountry = (lastChangedGroup !== 'country');
  document.querySelectorAll('.country-filter').forEach(cb => {
    const isAvailable = available.countries.has(cb.value);
    cb.disabled = !isAvailable;
    // Solo hide si no es el grupo que estamos editando
    cb.parentElement.style.display = (shouldHideCountry && !isAvailable) ? 'none' : '';
  });

  // 🔥 Sales Rep: SIEMPRE disable + hide (no es editable en cascada)
  document.querySelectorAll('.rep-filter').forEach(cb => {
    const isAvailable = available.reps.has(cb.value);
    cb.disabled = !isAvailable;
    cb.parentElement.style.display = isAvailable ? '' : 'none';
  });

  // Type: disable + hide
  document.querySelectorAll('.type-filter').forEach(cb => {
    const isAvailable = available.types.has(cb.value);
    cb.disabled = !isAvailable;
    cb.parentElement.style.display = isAvailable ? '' : 'none';
  });

  // Set: disable + hide
  document.querySelectorAll('.set-filter').forEach(cb => {
    const isAvailable = available.sets.has(cb.value);
    cb.disabled = !isAvailable;
    cb.parentElement.style.display = isAvailable ? '' : 'none';
  });

  {% if has_market_org %}
  // 🔥 Market Organization: SOLO disable (NUNCA hide) + NO hide si es el último cambiado
  const shouldDisableMarketOrg = (lastChangedGroup !== 'marketOrg');
  document.querySelectorAll('.marketorg-filter').forEach(cb => {
    const isAvailable = available.marketOrgs.has(cb.value);
    // Solo disable si no es el grupo que estamos editando
    cb.disabled = (shouldDisableMarketOrg && !isAvailable);
    // NUNCA hide para Market Org
    cb.parentElement.style.display = '';
  });
  {% endif %}
}

/**
 * 🔥 FIX: Refresca las opciones disponibles con leave-one-out.
 * @param {string} lastChangedGroup - 'country' | 'marketOrg' | null
 */
function refreshCascadeFilters(lastChangedGroup = null) {
  if (DEBUG) console.time('🔄 refreshCascadeFilters');
  
  // 🔥 Calcular availability para Country (excluyendo Country del filtro)
  const baseRowsForCountry = computeCascadeBase('country');
  const availableForCountry = computeAvailableValues(baseRowsForCountry);
  
  {% if has_market_org %}
  // 🔥 Calcular availability para MarketOrg (excluyendo MarketOrg del filtro)
  const baseRowsForMarketOrg = computeCascadeBase('marketOrg');
  const availableForMarketOrg = computeAvailableValues(baseRowsForMarketOrg);
  {% endif %}
  
  // 🔥 Calcular availability para el resto (Rep/Type/Set) con todos los filtros
  const baseRowsForRest = computeCascadeBase(null);
  const availableForRest = computeAvailableValues(baseRowsForRest);
  
  // 🔥 Merge: combinamos los sets calculados
  const available = {
    countries: availableForCountry.countries,
    reps: availableForRest.reps,
    types: availableForRest.types,
    sets: availableForRest.sets
    {% if has_market_org %}, marketOrgs: availableForMarketOrg.marketOrgs{% endif %}
  };
  
  // 🔥 Aplicar con hide selectivo
  applyAvailability(available, lastChangedGroup);
  
  if (DEBUG) {
    console.log('🔄 Cascade updated:', {
      lastChangedGroup,
      availableCountries: available.countries.size,
      availableReps: available.reps.size,
      {% if has_market_org %}availableMarketOrgs: available.marketOrgs.size{% endif %}
    });
    console.timeEnd('🔄 refreshCascadeFilters');
  }
}

// Debounced version para otros filtros
const refreshCascadeDebounced = debounce(() => refreshCascadeFilters(null), 300);

