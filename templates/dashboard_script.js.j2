// Normaliza country a ISO2 para KEYS (estable)
function normCountryForKey(v) {
  const s = String(v ?? '').trim().toLowerCase();
  if (!s) return '';
  
  // Si ya es ISO2 válido (2 letras), retornar
  if (s.length === 2 && /^[a-z]{2}$/.test(s)) return s;
  
  // Buscar en mapa
  return COUNTRY_ISO_MAP[s] || s;
}

