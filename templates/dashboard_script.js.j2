// ============================================
// SORT
// ============================================
function sortTable(colIndex) {
  if (sortState.column === colIndex) sortState.ascending = !sortState.ascending;
  else { sortState.column = colIndex; sortState.ascending = true; }
  renderTable();
}

// ============================================
// 🔥 RENDER TABLE (FIX #2 - LÍMITE DE FILAS)
// ============================================
function renderTable() {
  console.time('  ↳ renderTable');
  
  const tbody = $('tableBody');
  if (!tbody) return;

  const sortedData = [...filteredData].sort((a, b) => {
    let aVal, bVal;
    let currentCol = 0;

    // Date
    if (sortState.column === currentCol) {
      aVal = a.__dateObj || new Date(0);
      bVal = b.__dateObj || new Date(0);
      return sortState.ascending ? aVal - bVal : bVal - aVal;
    }
    currentCol++;

    // City
    if (HAS_CITY_DATA) {
      if (sortState.column === currentCol) {
        aVal = a.City || '';
        bVal = b.City || '';
      }
      currentCol++;
    }

    // Client
    if (sortState.column === currentCol) {
      aVal = a['Business Partner Name'] || '';
      bVal = b['Business Partner Name'] || '';
    }
    currentCol++;

    // Service
    if (sortState.column === currentCol) {
      aVal = a['Id - Name'] || a.ItemIdAndName || '';
      bVal = b['Id - Name'] || b.ItemIdAndName || '';
    }
    currentCol++;

    // Type
    if (sortState.column === currentCol) {
      aVal = a.ProductType || '';
      bVal = b.ProductType || '';
    }
    currentCol++;

    // Set
    if (sortState.column === currentCol) {
      aVal = a.Set || '';
      bVal = b.Set || '';
    }
    currentCol++;

    // Segment
    if (HAS_SEGMENT) {
      if (sortState.column === currentCol) {
        aVal = a['End User Segment'] || '';
        bVal = b['End User Segment'] || '';
      }
      currentCol++;
    }

    // Market Org
    if (HAS_MARKET_ORG) {
      if (sortState.column === currentCol) {
        aVal = a['Market Organization Name'] || '';
        bVal = b['Market Organization Name'] || '';
      }
      currentCol++;
    }

    // EUR
    if (sortState.column === currentCol) {
      aVal = a.EUR || 0;
      bVal = b.EUR || 0;
      return sortState.ascending ? aVal - bVal : bVal - aVal;
    }
    currentCol++;

    // Rep
    if (sortState.column === currentCol) {
      aVal = a.SalesRepresentative || '';
      bVal = b.SalesRepresentative || '';
    }

    if (typeof aVal === 'string') {
      return sortState.ascending ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
    }
    return sortState.ascending ? (aVal - bVal) : (bVal - aVal);
  });

  // 🔥 FIX #2: Limitar filas renderizadas
  const rowsToRender = sortedData.slice(0, MAX_TABLE_ROWS);
  const hiddenRows = sortedData.length - rowsToRender.length;

  tbody.innerHTML = '';

  rowsToRender.forEach(row => {
    const tr = document.createElement('tr');
    const date = row.__dateObj ? row.__dateObj.toLocaleDateString() : row.Date;

    let html = `<td>${escapeHtml(date)}</td>`;
    if (HAS_CITY_DATA) html += `<td>${escapeHtml(row.City || '')}</td>`;
    html += `<td>${getAccountLinkFromRow(row)}</td>`;
    html += `<td>${escapeHtml(row['Id - Name'] || row.ItemIdAndName || '')}</td>`;
    html += `<td>${escapeHtml(row.ProductType || '')}</td>`;
    html += `<td>${escapeHtml(row.Set || '')}</td>`;
    if (HAS_SEGMENT) html += `<td>${escapeHtml(row['End User Segment'] || '')}</td>`;
    if (HAS_MARKET_ORG) html += `<td>${escapeHtml(row['Market Organization Name'] || '')}</td>`;
    html += `<td>€${(row.EUR || 0).toFixed(2)}</td>`;
    html += `<td>${escapeHtml(row.SalesRepresentative || '')}</td>`;

    tr.innerHTML = html;
    tbody.appendChild(tr);
  });

  // 🔥 Mostrar aviso si hay filas ocultas
  if (hiddenRows > 0) {
    const warningRow = document.createElement('tr');
    warningRow.innerHTML = `<td colspan="20" style="text-align:center; background:#fff3cd; color:#856404; padding:10px; font-weight:bold;">
      ⚠️ Mostrando ${rowsToRender.length.toLocaleString()} de ${sortedData.length.toLocaleString()} filas (${hiddenRows.toLocaleString()} ocultas por rendimiento). Usa filtros para refinar resultados.
    </td>`;
    tbody.appendChild(warningRow);
  }

  // Sort indicator
  document.querySelectorAll('#serviceTable th').forEach((th, idx) => {
    th.classList.remove('sort-asc', 'sort-desc');
    if (idx === sortState.column) th.classList.add(sortState.ascending ? 'sort-asc' : 'sort-desc');
  });
  
  console.timeEnd('  ↳ renderTable');
}

// ============================================
// CSV EXPORT
// ============================================
function exportTableToCSV() {
  console.time('⏱️ CSV Export');
  
  // Preparar headers dinámicos según configuración
  const headers = ['Date'];
  if (HAS_CITY_DATA) headers.push('City');
  headers.push('Client', 'Service', 'Type', 'Set');
  if (HAS_SEGMENT) headers.push('Segment');
  if (HAS_MARKET_ORG) headers.push('Market Organization');
  headers.push('EUR', 'Sales Representative', 'Country', 'Postal Code');
  
  // Función para escapar campos CSV (maneja comillas y saltos de línea)
  function escapeCSV(value) {
    if (value == null) return '';
    const str = String(value);
    // Si contiene comillas, comas o saltos de línea, encerrar entre comillas y escapar comillas internas
    if (str.includes('"') || str.includes(',') || str.includes('\n') || str.includes('\r')) {
      return `"${str.replace(/"/g, '""')}"`;
    }
    return str;
  }
  
  // Construir CSV
  const csvRows = [];
  
  // Header row
  csvRows.push(headers.map(h => escapeCSV(h)).join(','));
  
  // Data rows (usar filteredData ordenado según sortState actual)
  const sortedData = [...filteredData].sort((a, b) => {
    let aVal, bVal;
    let currentCol = 0;

    // Date
    if (sortState.column === currentCol) {
      aVal = a.__dateObj || new Date(0);
      bVal = b.__dateObj || new Date(0);
      return sortState.ascending ? aVal - bVal : bVal - aVal;
    }
    currentCol++;

    // City
    if (HAS_CITY_DATA) {
      if (sortState.column === currentCol) {
        aVal = a.City || '';
        bVal = b.City || '';
      }
      currentCol++;
    }

    // Client
    if (sortState.column === currentCol) {
      aVal = a['Business Partner Name'] || '';
      bVal = b['Business Partner Name'] || '';
    }
    currentCol++;

    // Service
    if (sortState.column === currentCol) {
      aVal = a['Id - Name'] || a.ItemIdAndName || '';
      bVal = b['Id - Name'] || b.ItemIdAndName || '';
    }
    currentCol++;

    // Type
    if (sortState.column === currentCol) {
      aVal = a.ProductType || '';
      bVal = b.ProductType || '';
    }
    currentCol++;

    // Set
    if (sortState.column === currentCol) {
      aVal = a.Set || '';
      bVal = b.Set || '';
    }
    currentCol++;

    // Segment
    if (HAS_SEGMENT) {
      if (sortState.column === currentCol) {
        aVal = a['End User Segment'] || '';
        bVal = b['End User Segment'] || '';
      }
      currentCol++;
    }

    // Market Org
    if (HAS_MARKET_ORG) {
      if (sortState.column === currentCol) {
        aVal = a['Market Organization Name'] || '';
        bVal = b['Market Organization Name'] || '';
      }
      currentCol++;
    }

    // EUR
    if (sortState.column === currentCol) {
      aVal = a.EUR || 0;
      bVal = b.EUR || 0;
      return sortState.ascending ? aVal - bVal : bVal - aVal;
    }
    currentCol++;

    // Rep
    if (sortState.column === currentCol) {
      aVal = a.SalesRepresentative || '';
      bVal = b.SalesRepresentative || '';
    }

    if (typeof aVal === 'string') {
      return sortState.ascending ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
    }
    return sortState.ascending ? (aVal - bVal) : (bVal - aVal);
  });
  
  sortedData.forEach(row => {
    const rowData = [];
    
    // Date
    const date = row.__dateObj ? row.__dateObj.toLocaleDateString() : row.Date;
    rowData.push(escapeCSV(date));
    
    // City (si existe)
    if (HAS_CITY_DATA) {
      rowData.push(escapeCSV(row.City || ''));
    }
    
    // Client (nombre sin link)
    rowData.push(escapeCSV(row['Business Partner Name'] || ''));
    
    // Service
    rowData.push(escapeCSV(row['Id - Name'] || row.ItemIdAndName || ''));
    
    // Type
    rowData.push(escapeCSV(row.ProductType || ''));
    
    // Set
    rowData.push(escapeCSV(row.Set || ''));
    
    // Segment (si existe)
    if (HAS_SEGMENT) {
      rowData.push(escapeCSV(row['End User Segment'] || ''));
    }
    
    // Market Org (si existe)
    if (HAS_MARKET_ORG) {
      rowData.push(escapeCSV(row['Market Organization Name'] || ''));
    }
    
    // EUR (con 2 decimales)
    rowData.push(escapeCSV((row.EUR || 0).toFixed(2)));
    
    // Sales Representative
    rowData.push(escapeCSV(row.SalesRepresentative || ''));
    
    // Country
    rowData.push(escapeCSV(row.Country || ''));
    
    // Postal Code
    rowData.push(escapeCSV(row.PostalCode || ''));
    
    csvRows.push(rowData.join(','));
  });
  
  // Unir todas las filas
  const csvContent = csvRows.join('\n');
  
  // Crear blob y descargar
  const BOM = '\uFEFF';
  const blob = new Blob([BOM + csvContent], { type: 'text/csv;charset=utf-8;' });
  const link = document.createElement('a');
  
  // Generar nombre de archivo con timestamp
  const timestamp = new Date().toISOString().slice(0, 19).replace(/:/g, '-');
  const filename = `service_planning_export_${timestamp}.csv`;
  
  // Crear URL y descargar
  if (navigator.msSaveBlob) { // IE 10+
    navigator.msSaveBlob(blob, filename);
  } else {
    link.href = URL.createObjectURL(blob);
    link.download = filename;
    link.style.display = 'none';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  }
  
  console.timeEnd('⏱️ CSV Export');
  console.log(`✅ Exported ${sortedData.length} rows to ${filename}`);
}


